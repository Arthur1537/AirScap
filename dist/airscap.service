[Unit]
Description=ScanSnap eSCL Bridge Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Provision this dedicated account separately; never silently fall back to root.
User=airscap
Group=airscap
ExecStart=/usr/local/bin/airscap
EnvironmentFile=/etc/airscap/env
Restart=on-failure
RestartSec=10
StateDirectory=airscap

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# ScanSnap eSCL Bridge Configuration
# Copy to /etc/airscap/env and edit.

# Required (docs/network-trust.md): the scanner's fixed IPv4 address. No
# broadcast discovery: the first host to answer would be paired with.
AIRSCAP_SCANNER_IP=

# Required: scanner password from an owner-only file (0600/0400). Change the
# scanner's default password (last four characters of the serial) first.
# AIRSCAP_PASSWORD is not accepted (this file is usually world-readable).
AIRSCAP_PASSWORD_FILE=/etc/airscap/password

# HTTP listen port (default: 8080)
# AIRSCAP_LISTEN_PORT=8080

# Custom device name (default: use mDNS name of the discovered scanner)
# AIRSCAP_DEVICE_NAME=My Scanner

# Data directory for persistent settings (default: memory-only)
# AIRSCAP_DATA_DIR=/var/lib/airscap

# Log level: debug, info, warn, error (default: info)
# AIRSCAP_LOG_LEVEL=info

# Scan authorization by ScanSnap Control (docs/scan-authorization.md).
# Without both settings every scan is refused.
# Plain http only to a loopback address (co-located on the QNAP), else https.
# AIRSCAP_CONTROL_URL=http://127.0.0.1:18082
# Scanner token (SSC_SCANNER_TOKEN, >= 32 chars); file mode 0600 or 0400
# AIRSCAP_CONTROL_TOKEN_FILE=/etc/airscap/control-token
